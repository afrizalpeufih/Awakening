{
    "compilerOptions": {
        "composite": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "emitDeclarationOnly": true,
        "outDir": "./.tsbuild-node",
        "tsBuildInfoFile": "./.tsbuild-node/.tsbuildinfo"
    },
    "include": [
        "vite.config.ts"
    ]
}